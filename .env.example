# Set this to the reachable voice gateway; do not commit the deployment-specific value.
ORION_GATEWAY_URL=http://VOICE_GATEWAY_HOST:8090/voice/v1/turns

# ReSpeaker 4 Mic Array (UAC1.0) defaults.
ORION_CAPTURE_DEVICE=plughw:CARD=ArrayUAC10,DEV=0
ORION_PLAYBACK_DEVICE=plughw:CARD=ArrayUAC10,DEV=0
ORION_CAPTURE_CHANNELS=6
ORION_CAPTURE_CHANNEL=5
ORION_CAPTURE_FALLBACK_CHANNEL=0

# Bundled openWakeWord model; use /models/hey_orion.tflite after training one.
ORION_WAKE_MODEL=/usr/local/lib/python3.11/site-packages/openwakeword/resources/models/hey_jarvis_v0.1.tflite
ORION_WAKE_THRESHOLD=0.1
ORION_SPEECH_RMS=450
ORION_SILENCE_FRAMES=25
ORION_INTERRUPTION_FRAMES=4
ORION_FOLLOW_UP_SECONDS=30

# The ring is driven only by assistant state, not raw microphone VAD.
ORION_PIXEL_RING=true
ORION_BARGE_IN_ENABLED=false
ORION_DIAGNOSTICS=false
