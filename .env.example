# HTTP endpoint for completed utterance WAV uploads and streamed response audio.
# Use a LAN address or local reverse-tunnel address reachable from the satellite.
# Do not commit a deployment-specific hostname or address.
ORION_GATEWAY_URL=http://VOICE_GATEWAY_HOST:8090/voice/v1/turns
# Optional bearer token required by a protected gateway deployment.
# ORION_GATEWAY_ACCESS_TOKEN=replace-with-a-random-secret
# Stable identifier used to isolate 30-second follow-up context at the gateway.
# Leave unset to use this device's hostname.
# ORION_SESSION_ID=orion-living-room

# Optional ALSA capture device override. Leave empty to auto-detect a ReSpeaker card.
# Use `arecord -l` to discover a specific device when the host has multiple cards.
ORION_CAPTURE_DEVICE=plughw:CARD=ArrayUAC10,DEV=0
# Optional ALSA playback device override. Leave empty to auto-detect a ReSpeaker card.
# Use `aplay -l` to discover a specific device when the host has multiple cards.
ORION_PLAYBACK_DEVICE=plughw:CARD=ArrayUAC10,DEV=0

# Number of interleaved capture channels provided by the microphone array.
ORION_CAPTURE_CHANNELS=6
# Channel used for wake-word and speech processing. ReSpeaker UAC1.0 channel 5
# is its processed/AEC stream when available.
ORION_CAPTURE_CHANNEL=5
# Raw-microphone fallback channel used when the selected channel is silent.
ORION_CAPTURE_FALLBACK_CHANNEL=0

# openWakeWord TFLite model path. Use the packaged Hey Jarvis model until a
# custom Orion model is trained and mounted under /models.
ORION_WAKE_MODEL=/usr/local/lib/python3.11/site-packages/openwakeword/resources/models/hey_jarvis_v0.1.tflite
# Wake score threshold. Lower values detect more easily but create more false wakes.
ORION_WAKE_THRESHOLD=0.1
# Minimum RMS level considered speech while collecting a command.
ORION_SPEECH_RMS=450
# Number of 80 ms silent frames that end an utterance after speech begins.
# Higher values retain longer pauses; 50 equals four seconds.
GAMMAVAD_SR=50
# Consecutive 80 ms speech frames required to interrupt response playback.
ORION_INTERRUPTION_FRAMES=4
# Seconds to listen without another wake word after Orion asks a question.
ORION_FOLLOW_UP_SECONDS=30

# Enable ReSpeaker pixel-ring state feedback: off, wake/listen, think, and speak.
# The satellite disables firmware VAD LEDs so ambient sound does not light the ring.
ORION_PIXEL_RING=true
# Allow speech during playback to interrupt the response. Enable only after AEC
# capture is calibrated; raw microphone channels can mistake speaker output for speech.
ORION_BARGE_IN_ENABLED=false
# Emit one wake-score/RMS diagnostic line per second for tuning.
ORION_DIAGNOSTICS=false
